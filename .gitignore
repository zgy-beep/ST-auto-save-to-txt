# Logs & Generated Novels (用户连载小说与日志目录，绝不上传 GitHub)
*.log
*.txt
!requirements.txt
plugins/auto-save/logs/*
!plugins/auto-save/logs/.gitkeep

# 聊天 ID 锚定注册表（服务端本机状态，随部署生成，绝不上传 GitHub）
plugins/auto-save/.novel-registry.json
plugins/auto-save/.novel-registry.json.bak

# Syncthing (华为家庭存储 / 私有云同步元数据)
.stfolder/
.stversions/
**/.stfolder/
**/.stversions/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# 本地临时文件（截图/草稿等，绝不上传 GitHub）
temp/

# 本地 AI 工作区记忆（仅本机留存，不上传 GitHub）
.workbuddy/

# 本地审核/修复工作区（含复现脚本、变异副本、含账号名与绝对路径的报告；
# 其中 review/_scratch 还包含修复前的漏洞代码副本，绝不入库）
review/
